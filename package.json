{
  "name": "bountyhunter",
  "private": true,
  "version": "0.1.0",
  "description": "Bounty Hunter Cockpit: a cinematic Star Wars-inspired portfolio.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "export:hunter": "node scripts/export-hunter.mjs",
    "import:hunter": "node scripts/import-hunter.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "capture:media": "node scripts/capture-media.mjs",
    "og:image": "node scripts/og-image.mjs",
    "perf": "node scripts/perf-report.mjs"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.1.0",
    "@fontsource/rajdhani": "^5.1.0",
    "@fontsource/share-tech-mono": "^5.1.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@vercel/analytics": "^1.4.1",
    "gsap": "^3.12.5",
    "postprocessing": "^6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.170.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
